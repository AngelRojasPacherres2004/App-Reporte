<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="@color/primary"
                android:background="@drawable/circle_bg"
                android:backgroundTint="@color/primary_variant"
                android:padding="4dp"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:id="@+id/tvStudentNameAttendance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del Estudiante"
                android:textColor="@color/on_surface"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <RadioGroup
            android:id="@+id/rgAttendanceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <RadioButton
                android:id="@+id/rbPresent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Presente"
                android:buttonTint="@color/stable_green"
                android:textColor="@color/on_surface_variant"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbLate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tardanza"
                android:buttonTint="#F59E0B"
                android:textColor="@color/on_surface_variant"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbAbsent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Falta"
                android:buttonTint="@color/priority_red"
                android:textColor="@color/on_surface_variant"
                android:textSize="13sp" />
        </RadioGroup>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
